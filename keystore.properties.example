# Local release signing credentials template.
# Copy this file to keystore.properties (git-ignored) and fill in your values.
#
# storeFile is resolved relative to the project root (next to settings.gradle.kts).
# On CI, equivalent values are injected via KEYSTORE_PATH / KEYSTORE_PASSWORD /
# KEY_ALIAS / KEY_PASSWORD environment variables decoded from GitHub secrets.
storeFile=keystore.jks
storePassword=
keyAlias=easytier
keyPassword=
